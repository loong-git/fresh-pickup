{
  "app-plus": {
    "compilerVersion": 3,
    "distribute": {
      "android": { "permissions": [] },
      "ios": {},
      "sdkConfigs": {}
    },
    "modules": {},
    "nvueStyleCompiler": "uni-app",
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "autoclose": true,
      "delay": 0,
      "waiting": true
    },
    "usingComponents": true
  },
  // appid 按 F-18.17 §1.1 改成本端自己的占位串 __UNI__PARTNER01（S5-F1 收口：F-18.15 C-5 那句
  // 「appid 等其余键不动」是错的——各端不共用 appid，G-01 §3.1 的自述口径才是准的）。
  // 如实登记一件事：本值仍非可发行格式（真实 appid 形如 __UNI__ + 7 位十六进制），
  // HBuilderX 发行 / App 打包前必须在 DCloud 开发者中心为「生鲜主理人端」单独申请并替换；
  // 此刻它只保证「与商家端不再是同一枚」，供 H5 本地运行与三端隔离辨认。
  "appid": "__UNI__PARTNER01",
  "description": "生鲜主理人端（F-18.15~F-18.19 六页已交付：登录 / 工作台 / 核销台 / 到货批次 / 门店信息 / 入驻申请）",
  // H5 标题（C-5）：与 index.html 的 <title> 同值，页面 origin 断言靠它辨认——
  // C 端「生鲜配送」/ 商家端「生鲜商家端」/ 主理人端「生鲜主理人端」
  "h5": {
    "title": "生鲜主理人端"
  },
  "mp-alipay": { "usingComponents": true },
  "mp-baidu": { "usingComponents": true },
  "mp-toutiao": { "usingComponents": true },
  "mp-weixin": {
    // 小程序 appid 同样按 C-5 原样沿用拷来的占位串（wx0000000000000001 非可发行格式）：
    // 微信发行前必须在微信公众平台单独注册「生鲜主理人端」小程序并替换；
    // 开发阶段可在微信开发者工具导入本项目并选用测试号。当前占位仅供 H5 本地运行。
    "appid": "wx0000000000000001",
    "setting": {
      "urlCheck": false
    },
    "usingComponents": true
  },
  "name": "生鲜主理人端",
  "quickapp": {},
  "transformPx": false,
  "uniStatistics": {
    "enable": false
  },
  "versionCode": "100",
  "versionName": "1.0.0",
  "vueVersion": "3"
}
