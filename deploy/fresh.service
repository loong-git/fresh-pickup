# ============================================================================
# 生鲜配送后端 systemd 服务单元（M3-T-10 部署产出物，未实际部署）
# 功能：Spring Boot 后端注册为系统服务，崩溃/异常退出自动重启拉起（Restart=always），
#       开机自启（enable）。
#
# 安装步骤：
#   1. 打包：mvn -f backEnd/pom.xml clean package -DskipTests
#      产物：backEnd/target/fresh-server-1.0.0.jar
#   2. 部署目录：mkdir -p /data/fresh/backEnd /data/fresh/logs
#      cp backEnd/target/fresh-server-1.0.0.jar /data/fresh/backEnd/
#   3. 生产账号（推荐）：useradd -r -s /sbin/nologin fresh
#      chown -R fresh:fresh /data/fresh   （并把下方 User=root 改为 User=fresh）
#   4. 环境变量：修改下方 Environment= 占位值（DB_PASSWORD / JWT_SECRET / ADMIN_KEY）
#      或改用 EnvironmentFile=/data/fresh/backEnd/fresh.env 集中管理（权限 600）
#   5. cp deploy/fresh.service /etc/systemd/system/fresh.service
#      systemctl daemon-reload
#      systemctl enable --now fresh        # 开机自启 + 立即启动
#
# 运维命令：
#   systemctl status fresh               # 查看状态
#   journalctl -u fresh -f               # 跟踪 stdout/stderr（logback 文件日志在 /data/fresh/logs/fresh.log）
#   systemctl restart fresh              # 重启（更换 jar 后执行）
# ============================================================================

[Unit]
Description=Fresh Server (Spring Boot 3, 生鲜配送后端)
Documentation=https://spring.io/projects/spring-boot
# MySQL 服务名按发行版可能是 mysqld.service，按需调整
After=network.target mysql.service
Wants=network.target

[Service]
Type=simple
# 生产建议改专用低权限账号运行（见安装步骤 3）
User=root
WorkingDirectory=/data/fresh/backEnd

# ---- 环境变量（占位值必须替换！与 application-prod.yml 的 ${DB_PASSWORD}/${JWT_SECRET} 对应）----
# prod 未配置 JWT_SECRET 时启动即失败（M2 防呆设计），属预期行为
#
# ---- 上线前三件事（务必逐条确认，只靠防呆代码挡不住部署侧的疏漏）----
# 1) 本仓库的密钥守卫 AdminKeyProdGuard 是 @Profile("prod")，只在 profile 精确等于 prod 时注册。
#    部署命令行必须带 --spring.profiles.active=prod（见下方 ExecStart）；写成 production、拼错，
#    或压根没带该参数，守卫都静默不注册，而 admin-dev-key 这个默认值依旧在字节码里可用。
#    fail-fast 的强度取决于 profile 纪律，不取决于代码。
# 2) 下面三个占位值（replace-with-admin-key / replace-with-real-db-password /
#    replace-with-strong-random-secret）上线前必须全部替换成真实值，照抄 unit 文件等于裸奔：
#    ADMIN_KEY 的占位值已被启动守卫直接拒起（连同短于 8 位的弱值），
#    DB_PASSWORD / JWT_SECRET 两个占位串同样必须换成真实值——JWT_SECRET 留公开默认串意味着
#    任何人可离线伪造全量用户 token。
# 3) 生产密钥建议改由 EnvironmentFile=/data/fresh/backEnd/fresh.env（权限 600）注入，
#    不要写进本 unit 文件：unit 文件随仓库公开可读，把真实值写进来等于把密钥提交进版本库。
Environment=DB_PASSWORD=replace-with-real-db-password
Environment=JWT_SECRET=replace-with-strong-random-secret
Environment=ADMIN_KEY=replace-with-admin-key

# java -jar 方式启动（推荐）：显式 prod profile；日志目录通过 --log.path 传给 logback-spring.xml
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /data/fresh/backEnd/fresh-server-1.0.0.jar --spring.profiles.active=prod --log.path=/data/fresh/logs
# mvn 方式启动（备选，不推荐生产：需安装 maven 与源码）：
# ExecStart=/usr/bin/mvn -f /data/fresh/backEnd/pom.xml spring-boot:run -Dspring-boot.run.profiles=prod

# ---- 自愈与退出处理 ----
# 进程异常退出/被杀 5 秒后自动拉起
Restart=always
RestartSec=5
# 143 = SIGTERM 正常停机退出码（systemctl stop/restart 时不标记失败）
SuccessExitStatus=143

# 基础加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
